AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=your_azure_openai_api_key

LEAD_SEARCH_NOTES=

# Google Sheets destination
# You can provide either full URL or plain id.
GOOGLE_SHEET_ID=https://docs.google.com/spreadsheets/d/1N4XsyA4IICyEFxlSH-m3uoePU8EMDBywQVauMz9wNQE/edit
GOOGLE_SHEET_TAB=Sheet1

# Preferred auth: local service account JSON key file (ignored by git)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.local.json

# Alternate auth: uncomment and use these instead of key file
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email accuracy checks (enabled in both start + sync-sheet)
# Keep EMAIL_REQUIRE_SMTP=true for strict mailbox validation.
EMAIL_REQUIRE_SMTP=true
EMAIL_SMTP_TIMEOUT_MS=7000
EMAIL_MAX_MX_HOSTS=3
EMAIL_SMTP_HELO_HOST=localhost
EMAIL_SMTP_MAIL_FROM=verify@localhost
